\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/08/20 Academic CV style]

\RequirePackage[letterpaper,top=0.68in,bottom=0.55in,left=0.67in,right=0.86in,headheight=21pt,headsep=14pt,footskip=24pt]{geometry}
\RequirePackage[default]{sourcesanspro}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{fontawesome5}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{xurl}
\RequirePackage{hyperref}
\RequirePackage{etoolbox}

\definecolor{cvblue}{HTML}{159DDA}
\definecolor{cvdark}{HTML}{30323A}
\definecolor{cvmuted}{HTML}{60636B}

\hypersetup{
  colorlinks=true,
  linkcolor=cvblue,
  urlcolor=cvblue,
  pdfborder={0 0 0}
}
\urlstyle{same}

\newcommand{\cvheadrule}{\hbox to\headwidth{\color{cvblue}\leaders\hrule height 0.8pt\hfill}}

\fancypagestyle{cvbody}{%
  \fancyhf{}%
  \fancyhead[L]{\raisebox{-3pt}{\footnotesize\color{cvblue}\textbf{Emily Howerton}}}%
  \fancyhead[R]{\raisebox{-3pt}{\footnotesize\color{cvblue}Curriculum Vitae}}%
  \fancyfoot[C]{\footnotesize\color{cvdark}\thepage}%
  \renewcommand{\headrulewidth}{0.8pt}%
  \renewcommand{\headrule}{\cvheadrule}%
}

\fancypagestyle{cvfirst}{%
  \fancyhf{}%
  \fancyfoot[C]{\footnotesize\color{cvdark}\thepage}%
  \renewcommand{\headrulewidth}{0.8pt}%
  \renewcommand{\headrule}{\cvheadrule}%
}

\pagestyle{cvbody}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1.5em}
\linespread{1.06}
\color{cvdark}

\newcommand{\cvstar}{\raisebox{-0.1ex}{\scalebox{0.9}{*}}}

\newcommand{\cvheader}[4]{%
  \thispagestyle{cvfirst}%
  \begin{tabularx}{\textwidth}{@{}X>{\raggedleft\arraybackslash}p{0.39\textwidth}@{}}
    {\fontsize{22}{25}\selectfont\bfseries #1} & {\normalsize\faHome\enspace\href{#3}{\nolinkurl{#3}}} \\
    {\normalsize\color{cvmuted}#2} & {\normalsize\faEnvelope\enspace\href{mailto:#4}{#4}}
  \end{tabularx}
  \vspace{9pt}
}

\newcommand{\cvsection}[1]{%
  \Needspace{4\baselineskip}%
  \vspace{7pt}%
  {\fontsize{12}{14}\selectfont\bfseries\color{cvblue}\addfontfeatures{LetterSpace=2}\MakeUppercase{#1}}\par
  \vspace{4pt}%
}

\newcommand{\cvsubsection}[1]{%
  \Needspace{3\baselineskip}%
  \vspace{4pt}%
  {\fontsize{10}{12}\selectfont\bfseries #1}\par
  \vspace{2pt}%
}

\newcommand{\cveducation}[4]{%
  \Needspace{2.5\baselineskip}%
  \textbf{#1}, #2 \hfill (#3)\par
  \ifstrempty{#4}{}{\hspace*{0.1in}#4\par}
  \vspace{3pt}%
}

\newcommand{\cvdateditem}[2]{%
  \Needspace{2\baselineskip}%
  \begin{tabularx}{\textwidth}{@{}>{\raggedright\arraybackslash}p{0.14\textwidth}@{}X@{}}
    #1 & #2
  \end{tabularx}\par
}

\newcommand{\cvteachingrow}[3]{%
  \begin{tabularx}{\textwidth}{@{}p{0.07\textwidth}@{}X>{\raggedright\arraybackslash}p{0.36\textwidth}@{}}
    #1 & #2 & #3
  \end{tabularx}\par
}

\newcommand{\cvgrant}[2]{%
  \Needspace{4\baselineskip}%
  \textbf{#1}\par
  #2\par
  \vspace{5pt}%
}

\newcommand{\cvimpact}[1]{%
  \par\smallskip
  {\small\textit{Impact:} #1}\par
}

\newlist{cvnumbered}{enumerate}{1}
\setlist[cvnumbered]{
  label=\arabic*.,
  labelindent=0pt,
  labelwidth=0.17in,
  labelsep=0.07in,
  leftmargin=0.24in,
  itemsep=3pt,
  topsep=2pt,
  parsep=0pt,
  partopsep=0pt,
  align=left
}

\newenvironment{cvcompact}{%
  \begin{itemize}[leftmargin=0.19in,label={},itemsep=2pt,topsep=1pt,parsep=0pt]
}{%
  \end{itemize}
}
